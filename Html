<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Generador de Semitonos</title>
  <style>
    body {
      font-family: system-ui, sans-serif;
      background-color: #121212;
      color: #ffffff;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 20px;
      margin: 0;
    }
    .controles {
      background: #1e1e1e;
      padding: 15px;
      border-radius: 10px;
      width: 100%;
      max-width: 400px;
      display: flex;
      flex-direction: column;
      gap: 12px;
      margin-bottom: 20px;
    }
    label {
      display: flex;
      justify-content: space-between;
      font-size: 14px;
    }
    button {
      background-color: #007bff;
      color: white;
      border: none;
      padding: 12px;
      border-radius: 6px;
      font-size: 16px;
      font-weight: bold;
      cursor: pointer;
    }
    button:hover { background-color: #0056b3; }
    canvas {
      max-width: 100%;
      border: 1px solid #333;
      background-image: linear-gradient(45deg, #2a2a2a 25%, transparent 25%), 
                        linear-gradient(-45deg, #2a2a2a 25%, transparent 25%), 
                        linear-gradient(45deg, transparent 75%, #2a2a2a 75%), 
                        linear-gradient(-45deg, transparent 75%, #2a2a2a 75%);
      background-size: 20px 20px;
      background-position: 0 0, 0 10px, 10px -10px, -10px 0px;
    }
  </style>
</head>
<body>

  <h2>Semitonos Pro</h2>

  <div class="controles">
    <input type="file" id="upload" accept="image/*">
    
    <label>
      <span>Espaciado de trama: <strong id="valEspacio">8</strong>px</span>
      <input type="range" id="espacio" min="4" max="25" value="8">
    </label>

    <label>
      <span>Contraste / Tamaño: <strong id="valEscala">1.2</strong></span>
      <input type="range" id="escala" min="0.5" max="2.0" step="0.1" value="1.2">
    </label>

    <label>
      <span>Color de tinta:</span>
      <input type="color" id="colorTinta" value="#000000">
    </label>

    <button id="descargar">Descargar PNG Transparente</button>
  </div>

  <canvas id="canvas"></canvas>

  <script>
    const upload = document.getElementById('upload');
    const canvas = document.getElementById('canvas');
    const ctx = canvas.getContext('2d');
    const inputEspacio = document.getElementById('espacio');
    const inputEscala = document.getElementById('escala');
    const inputColor = document.getElementById('colorTinta');
    const btnDescargar = document.getElementById('descargar');

    let imagenOriginal = null;

    upload.addEventListener('change', (e) => {
      const archivo = e.target.files[0];
      if (!archivo) return;
      const lector = new FileReader();
      lector.onload = (evento) => {
        const img = new Image();
        img.onload = () => {
          imagenOriginal = img;
          procesarSemitono();
        };
        img.src = evento.target.result;
      };
      lector.readAsDataURL(archivo);
    });

    [inputEspacio, inputEscala, inputColor].forEach(el => {
      el.addEventListener('input', () => {
        document.getElementById('valEspacio').textContent = inputEspacio.value;
        document.getElementById('valEscala').textContent = inputEscala.value;
        if (imagenOriginal) procesarSemitono();
      });
    });

    function procesarSemitono() {
      const w = imagenOriginal.width;
      const h = imagenOriginal.height;
      canvas.width = w;
      canvas.height = h;

      // Lienzo temporal para leer los píxeles
      const tempCanvas = document.createElement('canvas');
      const tempCtx = tempCanvas.getContext('2d');
      tempCanvas.width = w;
      tempCanvas.height = h;
      tempCtx.drawImage(imagenOriginal, 0, 0);
      const datos = tempCtx.getImageData(0, 0, w, h).data;

      // Limpiar lienzo principal (fondo transparente)
      ctx.clearRect(0, 0, w, h);
      ctx.fillStyle = inputColor.value;

      const paso = parseInt(inputEspacio.value);
      const factor = parseFloat(inputEscala.value);

      for (let y = 0; y < h; y += paso) {
        for (let x = 0; x < w; x += paso) {
          const i = (y * w + x) * 4;
          const r = datos[i];
          const g = datos[i + 1];
          const b = datos[i + 2];
          const alfa = datos[i + 3];

          if (alfa < 128) continue; // Ignorar zonas transparentes

          // Calcular luminosidad
          const brillo = (0.299 * r + 0.587 * g + 0.114 * b) / 255;
          const oscuridad = 1 - brillo;
          const radio = (paso / 2) * oscuridad * factor;

          if (radio > 0.5) {
            ctx.beginPath();
            ctx.arc(x + paso / 2, y + paso / 2, radio, 0, Math.PI * 2);
            ctx.fill();
          }
        }
      }
    }

    btnDescargar.addEventListener('click', () => {
      if (!imagenOriginal) return;
      const enlace = document.createElement('a');
      enlace.download = 'semitono-naldo.png';
      enlace.href = canvas.toDataURL('image/png');
      enlace.click();
    });
  </script>
</body>
</html>
